{
  "enabled": true,
  "retry_on_errors": [429, 500, 502, 503, 504, 507],
  "retryable_error_patterns": [
    "rate limit",
    "too many requests",
    "429",
    "token limit",
    "context length",
    "context window",
    "maximum context",
    "input is too long",
    "quota",
    "usage limit",
    "credit balance",
    "model not found",
    "model is not supported",
    "insufficient balance"
  ],
  "max_fallback_attempts": 4,
  "cooldown_seconds": 0,
  "timeout_seconds": 30,
  "notify_on_fallback": true,
  "fallback_models": [
    "opencode/big-pickle",
    "opencode/deepseek-v4-flash-free",
    "ollama/qwen2.5-coder:7b"
  ]
}